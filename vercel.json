{
  "version": 2,
  "regions": ["fra1"],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://xzhmqevwjbvgfzerjmgx.supabase.co; img-src 'self' data: https://*.public.blob.vercel-storage.com https://xzhmqevwjbvgfzerjmgx.supabase.co; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://api.github.com https://portal.benditolab.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/area-clientes(\\.html)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/catalogo(\\.html)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/newsletter-.*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/formulario/.*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/articulo-.*",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/",
      "dest": "/portada.html"
    },
    {
      "src": "/colaboradores",
      "dest": "/colaboradores.html"
    },
    {
      "src": "/dilo-bonito",
      "dest": "/dilo-bonito.html"
    },
    {
      "src": "/bendito-lab",
      "dest": "/bendito-lab.html"
    },
    {
      "src": "/unete",
      "status": 301,
      "headers": {
        "Location": "/colaboradores#unete-form"
      }
    },
    {
      "src": "/faq",
      "dest": "/faq.html"
    },
    {
      "src": "/contacto",
      "dest": "/contacto.html"
    },
    {
      "src": "/catalogo",
      "dest": "/catalogo.html"
    },
    {
      "src": "/producto/(?:[^/]*-)?([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "dest": "/api/producto?id=$1"
    },
    {
      "src": "/area-clientes",
      "dest": "/area-clientes.html"
    },
    {
      "src": "/portal",
      "dest": "/area-clientes.html"
    },
    {
      "src": "/link-bio",
      "dest": "/link-bio.html"
    },
    {
      "src": "/bio",
      "dest": "/link-bio.html"
    },
    {
      "src": "/admin(\\.html)?",
      "status": 302,
      "headers": {
        "Location": "https://editorvisualbenditolabweb.vercel.app/"
      }
    },
    {
      "src": "/newsletter-colaboradores",
      "dest": "/newsletter-colaboradores.html"
    },
    {
      "src": "/newsletter-como-trabajamos",
      "dest": "/newsletter-como-trabajamos.html"
    },
    {
      "src": "/formulario/([A-Za-z0-9]+)",
      "dest": "https://app.benditolab.com/compartible/formulario/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "outputDirectory": "."
}
